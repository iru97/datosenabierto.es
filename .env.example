# ================================================================
# VARIABLES DE ENTORNO - datosenabierto.es
# ================================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ================================================================

# ================================================================
# SUPABASE
# ================================================================
# Obtener en: https://supabase.com/dashboard/project/_/settings/api

# URL de tu proyecto Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (segura para uso cliente)
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (SOLO para Netlify Functions, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ================================================================
# LLM API - Elige UNO (OpenAI o Anthropic)
# ================================================================
# El sistema detecta automáticamente cuál usar basándose en las keys disponibles
# Si ambas están configuradas, se usa OpenAI por defecto

# OPCIÓN 1: OpenAI (RECOMENDADO - Más barato)
# Obtener en: https://platform.openai.com/api-keys
# Costo: ~$0.15/1M input, ~$0.60/1M output con GPT-4o-mini
# Estimado mensual: ~$3-10
OPENAI_API_KEY=sk-proj-xxxxx

# OPCIÓN 2: Anthropic Claude (Alternativa)
# Obtener en: https://console.anthropic.com/settings/keys
# Costo: ~$1/1M input, ~$5/1M output con Claude 3.5 Haiku
# Estimado mensual: ~$20
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ================================================================
# NETLIFY (Opcional)
# ================================================================
# Estas variables se configuran automáticamente en Netlify
# Solo necesarias para desarrollo local con Netlify CLI

# NETLIFY_AUTH_TOKEN=your-netlify-token
# NETLIFY_SITE_ID=your-site-id

# ================================================================
# CONFIGURACIÓN DE APLICACIÓN
# ================================================================

# Modo de desarrollo
NODE_ENV=development

# URL base del sitio (para generación de URLs absolutas)
SITE_URL=http://localhost:3000

# ================================================================
# CRON JOBS (Netlify)
# ================================================================
# La función semanal está configurada en netlify.toml
# Se ejecuta cada domingo a las 7:00 AM UTC
# No requiere variables adicionales

# ================================================================
# RATE LIMITING (Opcional)
# ================================================================
# Límite de requests al proxy BOE (por IP por minuto)
BOE_API_RATE_LIMIT=30

# ================================================================
# CACHE (Opcional)
# ================================================================
# Tiempo de cache para sumarios BOE (en segundos)
BOE_CACHE_TTL=3600

# ================================================================
# NOTAS IMPORTANTES
# ================================================================
#
# 1. NUNCA commits este archivo con valores reales a git
# 2. El .env está en .gitignore por seguridad
# 3. En Netlify, configura estas variables en:
#    Site Settings > Environment variables
# 4. La ANON_KEY es segura para uso público
# 5. La SERVICE_ROLE_KEY debe ser SECRETA y solo en servidor
#
# ================================================================
